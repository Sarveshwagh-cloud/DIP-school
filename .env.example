# --- DIPS website email settings ---
# Copy this file to ".env.local" and fill in the values.

# Your Resend API key (from https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The inbox that receives enquiries.
# IMPORTANT: while you use the default sender below, this MUST be the same
# email you signed up to Resend with (that's a Resend rule for the free
# test sender). Use the school's Gmail and sign up to Resend with it.
SCHOOL_EMAIL=dips.umred@gmail.com

# Who the email appears to be "from".
# Leave this default until you verify a domain in Resend.
EMAIL_FROM=DIPS Website <onboarding@resend.dev>

# --- Cloudinary (Gallery image storage) ---
# Sign up at https://cloudinary.com (free plan = 25 GB)
# Find these in your Cloudinary Dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_api_secret

# These are used by the client-side upload widget (safe to expose)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_API_KEY=123456789012345

# --- Admin Panel ---
# Password for the gallery admin panel at /admin/gallery
ADMIN_PASSWORD=your_secure_password_here
